PORT=8080
DATABASE_URL=postgres://regs:password@localhost:5432/regs

# JWT EC P-256 keys (generate with: make gen-keys)
PRIVATE_KEY_PATH=./keys/private.pem
PUBLIC_KEY_PATH=./keys/public.pem

# Docker judge settings
DOCKER_IMAGE=yhlib/cs3060701
MAX_CONCURRENT_JOBS=3
TIME_LIMIT_SECONDS=10

# Storage paths
STORAGE_PATH=./storage
# HOST_STORAGE_PATH is the path on the HOST machine (needed when app runs inside Docker)
# If running locally with 'go run', this equals STORAGE_PATH
HOST_STORAGE_PATH=./storage
