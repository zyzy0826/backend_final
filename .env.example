# Copy to .env to override the defaults. Everything here is optional — the
# stack starts with `docker compose up -d --build` even without a .env file.

# --- Read by docker compose (host side) ---

# Host port the API is published on (container always listens on 8080).
APP_PORT=8080
# Host port for Postgres. Change it if 5432 is already taken on your machine.
DB_PORT=5432

# --- Read by the server (inside the container) ---

DOCKER_IMAGE=yhlib/cs3060701
MAX_CONCURRENT_JOBS=3
TIME_LIMIT_SECONDS=10
# Resource caps applied to execute-phase containers (empty = no limit)
JUDGE_MEMORY_LIMIT=512m
JUDGE_CPU_LIMIT=1.0
# Max upload size (MB) for submissions and problem packages
MAX_UPLOAD_MB=64

# Seed admin account created on startup (idempotent; leave blank to disable)
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=admin1234

# --- Only needed when running the server on the host (`go run ./cmd/server`)
# --- instead of in Docker. Under compose these are set in docker-compose.yml.
#
# PORT=8080
# DATABASE_URL=postgres://regs:password@localhost:5432/regs
# PRIVATE_KEY_PATH=./keys/private.pem
# PUBLIC_KEY_PATH=./keys/public.pem
# STORAGE_PATH=./storage
# STORAGE_VOLUME is the Docker volume backing STORAGE_PATH. Set under compose,
# left empty on the host so judge containers bind-mount HOST_STORAGE_PATH.
# STORAGE_VOLUME=
# HOST_STORAGE_PATH is STORAGE_PATH as the Docker daemon sees it.
# HOST_STORAGE_PATH=./storage
